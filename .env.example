# Salin file ini menjadi .env lalu isi nilainya.
# cp .env.example .env

# ---- Aplikasi ----
# Token sederhana untuk membuka UI & API. Kosongkan untuk tanpa auth (tidak disarankan di internet).
APP_TOKEN=
# Port & host server
PORT=5000
HOST=0.0.0.0
# Lokasi database SQLite & folder data
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
# Interval worker mengecek job baru (detik)
WORKER_POLL_SECONDS=5

# ---- Google (Sheets & Drive) ----
# Path ke file JSON service account Google. Bagikan (share) spreadsheet & folder Drive ke email service account ini.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# ID spreadsheet "Daftar video afiliet" (bagian .../d/<ID>/edit)
SHEET_ID=
# Nama tab/sheet di dalam spreadsheet
SHEET_TAB=Sheet1
# ID folder Drive "video afiliet" (kosongkan -> otomatis dicari/dibuat dari DRIVE_FOLDER_NAME)
DRIVE_FOLDER_ID=
DRIVE_FOLDER_NAME=video afiliet

# ---- LLM (OpenAI-compatible, 9Router Proxy) ----
LLM_BASE_URL=https://hermuse.thehanifz.my.id/v1
LLM_API_KEY=
LLM_MODEL=combo-ag

# ---- Image generation untuk storyboard (9Router Text to Image) ----
IMAGE_PROVIDER=openai
IMAGE_MODEL=ag/gemini-3.1-flash-image
IMAGE_BASE_URL=
IMAGE_API_KEY=
